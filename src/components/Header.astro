---
import { Image } from 'astro:assets';
import logoColor from '../assets/marca/ace-logo-color.svg';
import Icon from './Icon.astro';
import { site } from '../data/site';
import type { Link } from '../data/types';

export type PageKey = 'wt' | 'ti' | 'charlas';

interface Props {
  current?: PageKey;
  cta: Link & { short?: string }; // `short`: texto del botón en móvil, si el largo no entra
}

const { current, cta } = Astro.props;
const pageHref: Record<PageKey, string> = { wt: '/', ti: '/trainee-internship', charlas: '/charlas' };

// Nosotros vive en W&T y T&I; Contacto, en las 3 páginas (ver CLAUDE.md).
const tieneNosotros = current === 'wt' || current === 'ti';
const links: (Link & { active?: boolean })[] = [
  ...site.nav.map((l) => ({ ...l, active: current !== undefined && pageHref[current] === l.href })),
  { label: 'Nosotros', href: tieneNosotros ? '#nosotros' : '/#nosotros' },
  { label: 'Contacto', href: current ? '#contacto' : '/#contacto' },
];
---

<header class="sticky top-0 z-40 border-b border-ace-line bg-white">
  <div class="container-ace flex h-16 items-center justify-between gap-4 xl:h-[84px]">
    <a href="/" class="shrink-0" aria-label="ACE Perú, ir al inicio">
      <Image src={logoColor} alt="" class="h-auto w-[76px] xl:w-[100px]" loading="eager" />
    </a>

    <nav aria-label="Principal" class="hidden xl:block">
      <ul class="flex items-center gap-9 text-base text-ace-blue">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={l.active ? 'page' : undefined}
                class:list={[
                  'border-b-[3px] pb-1.5 no-underline transition-colors hover:border-ace-red',
                  l.active ? 'border-ace-red font-bold' : 'border-transparent',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={cta.href}
        class="rounded-full bg-ace-red px-4 py-3 text-sm font-bold text-white no-underline hover:bg-[#9f241f] xl:px-6 xl:py-3.5 xl:text-base"
      >
        {cta.short ? <><span class="xl:hidden">{cta.short}</span><span class="hidden xl:inline">{cta.label}</span></> : cta.label}
      </a>
      <button
        type="button"
        class="group flex size-11 items-center justify-center text-ace-blue xl:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <Icon name="menu" size={26} class="group-aria-expanded:hidden" />
        <Icon name="close" size={26} class="hidden group-aria-expanded:block" />
      </button>
    </div>
  </div>

  <nav
    id="menu-movil"
    aria-label="Principal"
    class="fixed inset-x-0 top-16 bottom-0 overflow-y-auto bg-white xl:hidden"
    hidden
    data-menu
  >
    <ul class="container-ace flex flex-col py-4">
      {
        links.map((l) => (
          <li class="border-b border-ace-line">
            <a
              href={l.href}
              aria-current={l.active ? 'page' : undefined}
              class:list={[
                'flex min-h-14 items-center text-lg text-ace-blue no-underline',
                l.active && 'font-bold',
              ]}
            >
              {l.active && <span class="mr-3 h-6 w-1 rounded-full bg-ace-red" aria-hidden="true" />}
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const focusables = () => [toggle, ...menu.querySelectorAll<HTMLElement>('a[href]')];

    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      menu.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLElement>('a[href]')?.focus();
      else if (returnFocus) toggle.focus();
    };
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    // Al tocar un enlace (incluidas las anclas de la misma página) se cierra.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        setOpen(false, true);
        return;
      }
      // Foco atrapado entre el botón y los enlaces del menú.
      if (e.key === 'Tab') {
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement as HTMLElement | null;
        if (!active || !items.includes(active)) {
          e.preventDefault();
          first.focus();
        } else if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    // Si la ventana pasa a escritorio con el menú abierto, se cierra.
    matchMedia('(min-width: 80rem)').addEventListener('change', (e) => {
      if (e.matches && isOpen()) setOpen(false);
    });
  }
</script>
