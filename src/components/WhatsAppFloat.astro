---
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site';

interface Props {
  message: string; // mensaje distinto en cada página
}

const { message } = Astro.props;
---

<a
  href={whatsappUrl(message)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp (se abre en una pestaña nueva)"
  class="fixed right-4 bottom-6 z-30 flex size-[60px] items-center justify-center rounded-full border-[3px] border-white bg-ace-red text-white transition-colors hover:bg-[#9f241f] lg:right-8 lg:size-16"
>
  <Icon name="chat" size={28} class="lg:size-[30px]" />
</a>
