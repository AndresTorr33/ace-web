---
// Página provisional de la fase 1: solo prueba header, footer y WhatsApp. Se reemplaza en las fases 2 a 4.
import BaseLayout from '../layouts/BaseLayout.astro';
import { workTravel as page } from '../data/work-travel';
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  current="wt"
  headerCta={page.headerCta}
  whatsappMessage={page.whatsappMessage}
>
  <section class="bg-ace-blue py-16 text-white lg:py-24">
    <div class="container-ace flex max-w-[1440px] flex-col gap-5">
      <p class="eyebrow">{page.hero.eyebrow}</p>
      <h1 class="max-w-3xl text-4xl leading-[1.05] lg:text-[62px] lg:leading-[1.03]">{page.hero.title}</h1>
      <p class="max-w-xl text-base leading-[1.45] lg:text-xl">{page.hero.lead}</p>
    </div>
  </section>
  <section id="nosotros" class="bg-ace-mist py-24"><div class="container-ace"><h2 class="text-[28px] text-ace-blue lg:text-[44px]">Nosotros</h2><p class="mt-3">Contenido en la fase siguiente.</p></div></section>
  <section id="contacto" class="bg-white py-24"><div class="container-ace"><h2 class="text-[28px] text-ace-blue lg:text-[44px]">Recibe la información</h2><p class="mt-3">Contenido en la fase siguiente.</p></div></section>
</BaseLayout>
